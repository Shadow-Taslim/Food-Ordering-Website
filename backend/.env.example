# Backend environment variables — copy to .env and fill in real values
PORT=4000

# MongoDB connection string (local, Atlas, or the docker-compose service name)
MONGO_URL=mongodb://localhost:27017/food-delivery

# Auth
JWT_SECRET=change_me_to_a_long_random_string
SALT=10

# Stripe (use TEST keys during development — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here

# From: stripe listen --forward-to localhost:4000/api/order/webhook
# or from a Dashboard webhook endpoint pointing at /api/order/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here
